<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8">
    <meta http-equiv="Content-type" content="text/html; charset=UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
    <link href="src/css/preloader.css" rel="stylesheet">
    <link rel="icon" type="image/png" href="src/images/logo-2.png">
    <title>YattoGram</title>
    <!-- META TAGS - OG & TWITTER -->
    <meta name="description" content="YattoGram - Это современный мессенджер. Современный дизайн, удобство использования и эргономичность.">
    <meta property="og:url" content="">
    <meta property="og:type" content="website">
    <meta property="og:title" content="YattoGram">
    <meta property="og:description" content="YattoGram - Это современный мессенджер. Современный дизайн, удобство использования и эргономичность.">
    <meta property="og:image" content="">
    <meta property="og:image:width" content="2712">
    <meta property="og:image:height" content="1139">
    <meta name="twitter:card" content="summary_large_image">
    <meta property="twitter:domain" content="">
    <meta property="twitter:url" content="">
    <meta name="twitter:title" content="YattoGram">
    <meta name="twitter:description" content="YattoGram - Это современный мессенджер. Современный дизайн, удобство использования и эргономичность.">
    <meta name="twitter:image" content="">
</head>
<body>
<div class="preloader" id="main_preloader">
    <div class="preloader__row">
        <div class="preloader__item"></div>
        <div class="preloader__item"></div>
    </div>
</div>
<div class="container-main" id="content"  hidden="hidden" style="display: none;">
    <div style="display: flex; width: 100%">
        <div class="block-chat-list">
            <div class="block-header">
                <div class="button-menu">
                    <img src="src/svg/menu.svg" id="menu_button" alt="Menu">
                </div>
                <div class="group-search">
                    <label>
                        <input placeholder="Поиск" id="search_users" type="text">
                    </label>
                </div>
            </div>
            <div class="block-chats">
                <div class="block-chat-info">
                    <img src="src/images/background.jpg" alt="User Avatar">
                    <div class="text-info">
                        <t class="chat-name">Брат (Спотифай)</t>
                        <t class="chat-message">АХВАХЫВАХЫВХАЫВХАЫВХАЫВХАХЫВАХЫВХАЫВХ</t>
                    </div>
                </div>
            </div>
        </div>
        <div class="block-chat">
            <div class="block-chat-header">
                Chat Header Panel
            </div>
            <div class="block-chat-input">
                <div class="message-input">
                    Message Input
                </div>
                <div class="message-button-send">

                </div>
            </div>
        </div>
    </div>

    <div class="block-history" id="history-block" hidden="hidden">
        <div class="preloader_mini" id="mini_preloader_1">
            <div class="preloader_mini__row">
                <div class="preloader_mini__item"></div>
                <div class="preloader_mini__item"></div>
            </div>
        </div>
    </div>
    <div class="block-notify" id="notify-block" hidden="hidden">
        <div class="preloader_mini" id="mini_preloader_2">
            <div class="preloader_mini__row">
                <div class="preloader_mini__item"></div>
                <div class="preloader_mini__item"></div>
            </div>
        </div>
    </div>
    <div class="block-settings" id="settings-block" hidden="hidden">

    </div>
    <div class="block-new-contact" id="add_contact_block" hidden="hidden" style="display: none">
        <div class="block-new-contact-title">Новый контакт</div>
        <t class="notify-input-field" id="notify_contact_name_field" style="display: none"></t>
        <form class="new-contact-form" autocomplete="off">
            <input class="new-contact-input" autocomplete="off" required id="new_contact_name" type="text">
            <label class="new-contact-label" for="new_contact_name">Введите имя контакта</label>
        </form>
        <t class="notify-input-field" id="notify_contact_id_field" style="display: none"></t>
        <form class="new-contact-form" autocomplete="off">
            <input class="new-contact-input" autocomplete="off" required id="new_contact_id" type="number">
            <label class="new-contact-label" for="new_contact_id">Введите ID кошелька</label>
        </form>
        <button class="new-contact-button" id="new_contact_next" type="button">
            <span class="new-contact-button-text" id="new_contact_button_text">Продолжить</span>
        </button>

        <button class="cancel-contact-button" id="cancel_contact_next" type="button">
            <span class="cancel-contact-button-text" id="cancel_contact_button_text">Назад</span>
        </button>
    </div>
</div>

<div class="no-support-device" hidden id="no-support">
    <div class="no-support-container">
        <div class="no-support-message">
            <img src="src/images/cry_duck.gif" alt="">
            <div>
                Извините, наше приложение не поддерживается на вашем устройстве :(
            </div>
        </div>
    </div>
</div>

<div id="js">
    <script src="src/js/libs/jquery.min.js"></script>
    <script src="https://www.cbr-xml-daily.ru/money.js"></script>
    <script src="src/js/libs/device-uuid.min.js"></script>
    <script src="src/js/main.js"></script>
    <script src="src/js/socket.js"></script>
    <script src="src/js/loader.js"></script>
</div>
</body>